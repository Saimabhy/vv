# Azure AD app registration (client credentials flow)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Users/mailboxes to run the pipeline for (comma-separated UPNs or IDs).
# The pipeline runs once per entry (the "xN" loop on the whiteboard).
GRAPH_TARGET_USERS=user1@contoso.com,user2@contoso.com

# SharePoint site to pull Projects from (hostname:path or site ID)
GRAPH_SHAREPOINT_SITE=contoso.sharepoint.com:/sites/ProjectHub
