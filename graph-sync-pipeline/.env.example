# Azure AD app registration.
# AZURE_TENANT_ID and AZURE_CLIENT_ID are always required.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- `npm run test-me` (delegated auth, no admin consent needed) ---
# Only needs AZURE_TENANT_ID + AZURE_CLIENT_ID above. The app registration
# must allow public client flows (Authentication > Advanced settings >
# "Allow public client flows" = Yes). You sign in interactively via device
# code and it reads only your own mailbox/OneDrive.

# --- `npm start` (full app-only pipeline, needs admin consent) ---
# Requires the app registration to have a client secret, and application
# permissions User.Read.All / Mail.Read / Files.Read.All / Sites.Read.All
# granted with admin consent.
AZURE_CLIENT_SECRET=

# Users/mailboxes to run the pipeline for (comma-separated UPNs or IDs).
# The pipeline runs once per entry (the "xN" loop on the whiteboard).
GRAPH_TARGET_USERS=user1@contoso.com,user2@contoso.com

# SharePoint site to pull Projects from (hostname:path or site ID)
GRAPH_SHAREPOINT_SITE=contoso.sharepoint.com:/sites/ProjectHub
